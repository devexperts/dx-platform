{
  "name": "@devexperts/platform-utils",
  "version": "1.0.0",
  "description": "",
  "main": "dist",
  "module": "dist",
  "scripts": {
    "lint": "eslint ./**/*.ts",
    "lint:fix": "yarn lint --fix",
    "test": "yarn lint && tsc --noEmit && jest",
    "build": "tsc -p ./tsconfig.build.json --outDir ./dist",
    "pack": "npm pack",
    "clean": "rm -rf ./dist",
    "prepare": "yarn clean && yarn build",
    "start": "yarn watch",
    "watch": "yarn build --watch --incremental"
  },
  "publishConfig": {
    "registry": "https://github.com/devexperts/dx-platform"
  },
  "author": "devexperts",
  "dependencies": {
    "tslib": "^2.5.0",
    "typelevel-ts": "^0.3.5"
  },
  "peerDependencies": {
    "fp-ts": "^2.0.5",
    "io-ts": "^2.2.20",
    "io-ts-types": "^0.5.19"
  },
  "devDependencies": {
    "@types/jest": "^24.0.18",
    "eslint": "^8.34.0",
    "fp-ts": "^2.0.5",
    "io-ts": "^2.2.20",
    "io-ts-types": "^0.5.19",
    "jest": "^24.9.0",
    "ts-jest": "^24.1.0",
    "typescript": "^4.9.5"
  }
}
