{
  "name": "@devexperts/platform-rx-utils",
  "version": "1.0.0",
  "description": "utilits for rxjs",
  "keywords": [
    "rxjs",
    "devexperts",
    "observable"
  ],
  "main": "dist",
  "module": "dist",
  "author": "devexperts",
  "scripts": {
    "lint": "eslint ./**/*.{ts,js}",
    "lint:fix": "yarn lint --fix",
    "test": "tsc --noEmit && jest",
