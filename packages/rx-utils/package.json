  },
  "devDependencies": {
    "@devexperts/remote-data-ts": "^2.0.0",
    "@types/jest": "^24.0.18",
    "eslint": "^8.34.0",
    "fp-ts": "^2.0.5",
    "fp-ts-rxjs": "^0.6.4",
    "jest": "^24.9.0",
    "rxjs": "7.5.7",
    "ts-jest": "^24.1.0",
    "typescript": "^4.9.5"
  },
  "peerDependencies": {
    "@devexperts/remote-data-ts": "^2.0.0",
    "fp-ts": "^2.0.5",
    "fp-ts-rxjs": "^0.6.4",
    "rxjs": "7.5.7"
  },
  "publishConfig": {
